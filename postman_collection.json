{
  "info": {
    "_postman_id": "0e35d0c0-7fdf-44f9-85c2-bc2c0f6f2a7b",
    "name": "Nest Hexagonal API",
    "description": "Library / Author / Book aggregates + health check. Run against a local instance (npm run start:dev, docker compose up -d for Postgres). Folder order matters when run top-to-bottom: Book depends on Library + Author existing (rule 1 cross-aggregate check), and Postgres now enforces the same dependency as a real FK, so Library/Author deletes are pushed into a final Cleanup folder, after Book is created and deleted.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "libraryId", "value": "11111111-1111-1111-1111-111111111111", "type": "string" },
    { "key": "authorId", "value": "33333333-3333-3333-3333-333333333333", "type": "string" },
    { "key": "bookId", "value": "55555555-5555-5555-5555-555555555555", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Get Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Libraries",
      "item": [
        {
          "name": "Create Library",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('libraryId', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Central Library\",\n  \"address\": \"123 Main St\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/libraries",
              "host": ["{{baseUrl}}"],
              "path": ["libraries"]
            }
          },
          "response": []
        },
        {
          "name": "Get Library by Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/libraries/{{libraryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["libraries", "{{libraryId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authors",
