              "raw": "{\n  \"title\": \"Domain-Driven Design\",\n  \"description\": \"Tackling complexity in the heart of software\",\n  \"authorId\": \"{{authorId}}\",\n  \"libraryId\": \"{{libraryId}}\"\n}",
