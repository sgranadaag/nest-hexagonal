{
  "info": {
    "_postman_id": "0e35d0c0-7fdf-44f9-85c2-bc2c0f6f2a7b",
    "name": "Nest Hexagonal API",
    "description": "Library / Author / Book aggregates + health check, covering both the REST routes (top-level folders) and the equivalent GraphQL operations (the GraphQL folder) against the same running instance. Run against a local instance (npm run start:dev, docker compose up -d for Postgres). Folder order matters when run top-to-bottom: Book depends on Library + Author existing (rule 1 cross-aggregate check), and Postgres now enforces the same dependency as a real FK, so Library/Author deletes are pushed into a final Cleanup folder, after Book is created and deleted. The GraphQL folder mirrors this exact same order internally and reuses the same collection variables, so it's meant to run after the REST folders (and their Cleanup) have already completed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
